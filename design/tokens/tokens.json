      "size": "19px",
      "lineHeight": "37px",
      "weight": 400,
      "family": "sans"
    },
    "body": {
      "size": "17px",
      "lineHeight": "33px",
      "weight": 400,
      "family": "sans"
    },
    "body-sm": {
      "size": "15px",
      "lineHeight": "29px",
      "weight": 400,
      "family": "sans"
    },
    "label": {
      "size": "14px",
      "lineHeight": "22px",
      "weight": 600,
      "family": "sans"
    },
    "caption": {
      "size": "13px",
      "lineHeight": "25px",
      "weight": 400,
      "family": "sans"
    },
    "button": {
      "size": "16px",
      "lineHeight": "24px",
      "weight": 600,
      "family": "sans"
    }
  },
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "24px",
    "6": "32px",
    "7": "48px",
    "8": "64px",
    "9": "96px",
    "10": "144px"
  },
  "radius": {
    "none": "0",
    "sm": "6px",
    "md": "12px",
    "pill": "999px"
  },
  "shadow": {
    "overlay": {
      "light": "0 24px 64px -16px rgba(21,25,34,0.36),0 2px 8px rgba(21,25,34,0.12)",
      "dark": "0 24px 64px -16px rgba(0,0,0,0.7),0 0 0 1px rgba(255,255,255,0.04)"
    }
  },
  "duration": {
    "fast": "140ms",
    "base": "240ms",
    "slow": "700ms"
  },
  "ease": {
    "out": "cubic-bezier(0.2,0.7,0.1,1)",
    "standard": "cubic-bezier(0.65,0,0.35,1)"
  },
  "z": {
    "nav": "40",
    "modal": "100",
    "toast": "110"
  },
  "layout": {
    "contentMax": "1200px",
    "gutter": "24px",
    "measure": "64ch"
  }
}