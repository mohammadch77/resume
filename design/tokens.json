{
  "$schema": "Grin Web v2 tokens. Source of truth for the look: design/reference/lumora-prompt.md + the two hero images. Generated to app/tokens.css and app/theme.css by scripts/gen-tokens.ts.",
  "color": {
    "paper": "#ffffff",
    "surface": "#f1f0ee",
    "surface-2": "#e3e2df",
    "ink": "#141414",
    "ink-muted": "#5c5a57",
    "ink-subtle": "#6b6965",
    "ink-faint": "#8d8d8d",
    "line": "#e6e5e2",
    "line-strong": "#8d8d8d",
    "accent": "#ec3f1e",
    "accent-ink": "#cc310f",
    "accent-hover": "#f25a3d",
    "on-accent": "#141414",
    "on-ink": "#ffffff",
    "on-ink-muted": "#a8a6a2",
    "on-ink-faint": "#8f8d89",
    "focus-ring": "#ec3f1e",
    "success": "#0b6b5c",
    "success-tint": "#ddf3ee",
    "danger": "#b42318",
    "danger-tint": "#fbe4e1",
    "scrim": "rgba(20,20,20,0.3)"
  },
  "font": {
    "sans": "\"Estedad\",Tahoma,system-ui,sans-serif"
  },
  "weight": { "regular": 400, "semibold": 600 },
  "type": {
    "display-xl": { "size": "4.5rem", "lineHeight": "1.3" },
    "display-lg": { "size": "3.75rem", "lineHeight": "1.3" },
    "display-md": { "size": "3rem", "lineHeight": "1.3" },
    "heading-1": { "size": "2.25rem", "lineHeight": "1.35" },
    "heading-2": { "size": "1.875rem", "lineHeight": "1.4" },
    "heading-3": { "size": "1.5rem", "lineHeight": "1.5" },
    "stat": { "size": "4.5rem", "lineHeight": "1.2" },
    "body-lg": { "size": "1.125rem", "lineHeight": "2" },
    "body": { "size": "1rem", "lineHeight": "1.9" },
    "body-sm": { "size": "0.875rem", "lineHeight": "1.9" },
    "label": { "size": "0.875rem", "lineHeight": "1.6" },
    "caption": { "size": "0.75rem", "lineHeight": "1.8" },
    "button": { "size": "0.875rem", "lineHeight": "1.5" }
  },
  "radius": {
    "none": "0",
    "sm": "0.375rem",
    "md": "0.75rem",
    "control": "0.875rem",
    "card-sm": "1.25rem",
    "card": "2rem",
    "pill": "9999px"
  },
  "ease": {
    "out": "cubic-bezier(0.2,0.7,0.1,1)",
    "standard": "cubic-bezier(0.65,0,0.35,1)",
    "spring": "cubic-bezier(0.2,0.8,0.2,1)",
    "reveal": "cubic-bezier(0.215,0.61,0.355,1)"
  },
  "duration": { "fast": "140ms", "base": "240ms", "hover": "350ms", "slow": "700ms" },
  "z": { "nav": 50, "menu": 115, "modal": 110, "toast": 120 },
  "layout": { "shell": "88rem", "hairline": "1px", "focus-width": "2px", "focus-offset": "2px" },
  "legacy": {
    "note": "Names the old design system and the admin still use. Each maps to a v2 token. Deleted with components/ds in phase 5.",
    "color": {
      "raised": "paper",
      "sunken": "surface",
      "lapis": "accent",
      "lapis-deep": "accent-hover",
      "lapis-tint": "surface",
      "lapis-text": "accent-ink",
      "on-lapis": "on-accent",
      "saffron": "accent",
      "on-saffron": "on-accent",
      "saffron-text": "accent-ink",
      "saffron-tint": "surface",
      "firouzeh": "accent"
    },
    "raw": [
      "--space-1:4px;--space-2:8px;--space-3:12px;--space-4:16px;--space-5:24px;--space-6:32px;--space-7:48px;--space-8:64px;--space-9:96px;--space-10:144px;",
      "--border-hairline:1px;--border-rule:4px;--content-max:1200px;--gutter:var(--space-5);--measure-prose:64ch;",
      "--shadow-overlay:0 24px 64px -16px rgba(20,20,20,0.36),0 2px 8px rgba(20,20,20,0.12);",
      "--font-display:var(--font-sans);--font-weight-display:600;",
      "--surface-page:var(--color-paper);--surface-card:var(--color-paper);--surface-well:var(--color-surface);--surface-inverse:var(--color-ink);",
      "--text-body-color:var(--color-ink);--text-muted-color:var(--color-ink-muted);--text-subtle-color:var(--color-ink-subtle);--text-link-color:var(--color-accent-ink);--text-inverse-color:var(--color-paper);",
      "--border-decorative:var(--color-line);--border-control:var(--color-line-strong);",
      "--accent:var(--color-accent);--accent-hover:var(--color-accent-hover);--on-accent:var(--color-on-accent);"
    ]
  }
}
