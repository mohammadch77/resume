{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/button/**",
              "components/chip/**",
              "components/field/**",
              "components/icon/**",
              "components/metric/**",
              "components/modal/**",
              "components/navbar/**",
              "components/project-card/**",
              "components/testimonial/**",
              "ui_kits/landing/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Estedad|Vazirmatn UI FD))/i]",
        "message": "Font not provided by the design system. Available: Estedad, Vazirmatn UI FD."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|href|iconStart|iconEnd|iconOnly|label|disabled|type|className|onClick|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, href, iconStart, iconEnd, iconOnly, label, disabled, type, className, onClick, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|quiet|danger|on-lapis)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'quiet' | 'danger' | 'on-lapis'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Button> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|selected|onClick|icon|className|children|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: variant, selected, onClick, icon, className, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:tag|outline|filter|success|warning|danger)$/]",
        "message": "<Chip> variant must be one of 'tag' | 'outline' | 'filter' | 'success' | 'warning' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CoverArt'] > JSXAttribute > JSXIdentifier[name!=/^(?:art|image|alt|sample|sampleLabel|className|style|key|ref|className|style|children)$/]",
        "message": "<CoverArt> doesn't accept that prop. Declared props: art, image, alt, sample, sampleLabel, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CropFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:gap|className|style|children|key|ref|className|style|children)$/]",
        "message": "<CropFrame> doesn't accept that prop. Declared props: gap, className, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|multiline|optional|id|name|type|placeholder|value|defaultValue|disabled|required|inputMode|autoComplete|dir|onChange|className|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, hint, error, multiline, optional, id, name, type, placeholder, value, defaultValue, disabled, required, inputMode, autoComplete, dir, onChange, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute[name.name='dir'] > Literal[value!=/^(?:rtl|ltr|auto)$/]",
        "message": "<Field> dir must be one of 'rtl' | 'ltr' | 'auto'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|mirror|label|className|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, mirror, label, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Metric'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|source|sample|className|style|key|ref|className|style|children)$/]",
        "message": "<Metric> doesn't accept that prop. Declared props: value, label, source, sample, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Modal'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|onClose|title|tags|art|image|alt|sample|challenge|solution|outcome|labels|primaryLabel|primaryHref|onPrimary|secondaryLabel|onSecondary|contained|className|key|ref|className|style|children)$/]",
        "message": "<Modal> doesn't accept that prop. Declared props: open, onClose, title, tags, art, image, alt, sample, challenge, solution, outcome, labels, primaryLabel, primaryHref, onPrimary, secondaryLabel, onSecondary, contained, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|key|ref|className|style|children)$/]",
        "message": "<NavLink> doesn't accept that prop. Declared props: label, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProjectCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|summary|tags|art|image|alt|sample|ctaLabel|onOpen|href|headingLevel|className|style|key|ref|className|style|children)$/]",
        "message": "<ProjectCard> doesn't accept that prop. Declared props: title, summary, tags, art, image, alt, sample, ctaLabel, onOpen, href, headingLevel, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Testimonial'] > JSXAttribute > JSXIdentifier[name!=/^(?:quote|name|role|sample|className|style|key|ref|className|style|children)$/]",
        "message": "<Testimonial> doesn't accept that prop. Declared props: quote, name, role, sample, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ServiceCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|index|headingLevel|className|style|key|ref|className|style|children)$/]",
        "message": "<ServiceCard> doesn't accept that prop. Declared props: icon, title, index, headingLevel, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ServiceGrid'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|className|key|ref|className|style|children)$/]",
        "message": "<ServiceGrid> doesn't accept that prop. Declared props: label, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='CtaBand'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|text|ctaLabel|ctaHref|headingLevel|className|key|ref|className|style|children)$/]",
        "message": "<CtaBand> doesn't accept that prop. Declared props: title, text, ctaLabel, ctaHref, headingLevel, className."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
