{
  "name": "grin-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "fonts:subset": "python scripts/subset-fonts.py --check",
    "landing:compare": "tsx scripts/landing-compare.ts",
    "ds:screenshots": "tsx scripts/ds-screenshots.ts",
    "tokens:gen": "tsx scripts/gen-tokens.ts",
    "tokens:check": "tsx scripts/gen-tokens.ts --check && tsx scripts/tokens-check.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:db": "docker compose -f deploy/docker-compose.test.yml up -d --wait && vitest run --config vitest.db.config.ts",
    "test:e2e": "docker compose -f deploy/docker-compose.test.yml up -d --wait && tsx scripts/e2e-db.ts && playwright test",
    "lhci": "tsx scripts/lhci.ts",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "seed:owner": "tsx --env-file-if-exists=.env scripts/seed-owner.ts",
    "test:icu:docker": "docker build -t grin-web:icu . && docker run --rm -i grin-web:icu node --input-type=module - < scripts/icu-check.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^5.9.2",
    "@node-rs/argon2": "^2.2.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "sharp": "^0.35.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
